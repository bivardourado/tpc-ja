  font-weight: 400;

  color-scheme: dark;
  }

  body {
    margin: 0;
    background-color: var(--bg-color);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  #app {
    width: 100%;
    max-width: 1400px;
    /* Mais largo para o dashboard */
    margin: 0 auto;
    padding: 2rem;
    box-sizing: border-box;
  }

  /* Navegação */
  nav {
    display: flex;
    gap: 20px;
    margin-bottom: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }

  nav a:hover {
    color: var(--text-primary);
    background-color: var(--surface-hover);
  }

  nav a.active {
    color: var(--primary-color);
    background-color: rgba(74, 144, 226, 0.1);
  }

  /* Layout do Dashboard */
  .dashboard-header {
    margin-bottom: 2rem;
  }

  .dashboard-header h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .dashboard-card {
    background-color: var(--surface-color);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
  }

  .dashboard-card h2 {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  /* Componentes de Formulário */
  input,
  select {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.8rem;
    border-radius: 6px;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--primary-color);
  }

  button {
    background-color: var(--surface-hover);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  button:hover {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: white;
  }

  button.btn-primary {
    background-color: var(--primary-color);
    color: white;
    border: none;
  }

  button.btn-primary:hover {
    background-color: var(--primary-hover);
  }

  /* Tabelas */
  .table-responsive {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }

  th,
  td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  th {
    background-color: var(--surface-hover);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  tr:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  /* Utilitários */
  .text-danger {
    color: var(--danger-color);
  }

  .capitalize {
    text-transform: capitalize;
  }

  .placeholder-text {
    color: var(--text-secondary);
    font-style: italic;
  }

  /* Ajustes Específicos */
  .scale-controls {
    background-color: transparent;
    padding: 0;
    margin-bottom: 1rem;
  }

  .location-list {
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }

  .location-item {
    background-color: var(--bg-color);
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .location-item:hover {
    background-color: var(--surface-hover);
  }

  .btn-delete:hover {
    background-color: rgba(207, 102, 121, 0.2);
    color: var(--danger-color);
  }

  /* Estilos do ScaleConfigurator */
  .scale-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .icon {
    margin-right: 0.5rem;
  }

  /* Consulta de Escala */
  .consulta-escala-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .consulta-form {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
  }

  .consulta-form .form-group {
    flex: 1;
    margin: 0;
  }

  .designacoes-list {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .designacao-card {
    background-color: var(--bg-color);
    border-radius: 8px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    position: relative;
    transition: transform 0.2s, border-color 0.2s;
  }

  .designacao-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary-color);
  }

  .designacao-numero {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: var(--primary-color);
    color: var(--bg-color);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
  }

  .designacao-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .designacao-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }

  .designacao-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
    min-width: 140px;
  }

  .designacao-value {
    color: var(--text-primary);
    font-weight: 500;
    text-align: right;
    flex: 1;
  }

  @media (max-width: 640px) {
    .consulta-form {
      flex-direction: column;
      align-items: stretch;
    }

    .designacao-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .designacao-value {
      text-align: left;
    }
  }

  /* Configuração de Locais */
  .weekly-config {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .day-row {
    display: flex;
    flex-direction: column;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .day-row:last-child {
    border-bottom: none;
  }

  .day-label {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .shifts-options {
    display: flex;
    gap: 1.5rem;
  }

  .shifts-options label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .site-footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background: var(--surface-color);
    color: var(--text-secondary);
    text-align: center;
    padding: 0.5rem 0;
    font-size: 0.9rem;
  }

  /* Location item styling */
  .loc-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .loc-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .loc-detail {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .styled-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .styled-list li {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .styled-list li:last-child {
    border-bottom: none;
  }

  .location-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .btn-delete {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0.5rem;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .btn-delete:hover {
    opacity: 1;
    background-color: rgba(207, 102, 121, 0.2);
  }

  .empty-message {
    color: var(--text-secondary);
    font-style: italic;
    padding: 1rem;
    text-align: center;
  }

  .hint {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .inline-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .inline-form input {
    flex: 1;
  }